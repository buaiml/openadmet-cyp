#!/bin/bash -l
#$ -P buaisociety
#$ -N train_chemprop
#$ -j y
#$ -o train_chemprop.qlog
#$ -l h_rt=12:00:00
#$ -l gpus=1
#$ -l gpu_c=9.0               # keep: older GPUs lack kernels for our torch build
#$ -pe omp 4

module load miniconda
conda activate cyp

export PYTHONNOUSERSITE=1      # don't let ~/.local packages shadow the conda env
cd "$SGE_O_WORKDIR"

# Data is gitignored; fetch it once on the cluster (skips files already present):
#   download-data
if [ ! -f data/train.csv ] || [ ! -d data/metabolism ]; then
    echo "Missing data/. Run download-data first." >&2
    exit 1
fi

# Extra args replace the default run, so pick the whole configuration yourself:
#   one stage, everything jointly (the default below):
#     qsub scripts/train_chemprop.qsub --datasets tdc_hlm tdc_rlm pubchem:CYP1A2 bindingdb:CYP1A2,CYP2C8 chembl:CYP1A2,CYP2C8 --loss-function mae
#   pretrain on stability, then train on the challenge plus auxiliary heads:
#     qsub scripts/train_chemprop.qsub --stage tdc_hlm tdc_rlm --stage pubchem:CYP1A2 bindingdb:CYP1A2,CYP2C8 chembl:CYP1A2,CYP2C8 --loss-function mae
#   other seed / output directory (use the same seeds across A/B arms):
#     qsub scripts/train_chemprop.qsub --seed 1 --output-dir results/chemprop/ab_seed1 --datasets ...
if [ "$#" -eq 0 ]; then
    set -- --datasets tdc_hlm tdc_rlm pubchem:CYP1A2 bindingdb:CYP1A2,CYP2C8 chembl:CYP1A2,CYP2C8 \
        --loss-function mae --show-individual-scores
fi

train-chemprop "$@"
