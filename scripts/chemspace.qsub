#!/bin/bash -l
#$ -N chemspace
#$ -j y
#$ -o chemspace.qlog
#$ -l h_rt=6:00:00           # fingerprinting ~39k molecules, then PCA + t-SNE + UMAP over them
#$ -l mem_per_core=8G        # the 39k x 2048 float32 fingerprint matrix plus t-SNE working set
#$ -pe omp 8                 # CPU only -- no GPU, this trains nothing. t-SNE and UMAP thread.

# No `#$ -P` here on purpose. SGE parses `#$` lines literally -- they never
# expand environment variables -- so a project baked into the file can only be
# changed by editing the file, which leaves everyone carrying a dirty working
# tree. Precedence is instead: ~/.sge_request < `#$` directives < command line,
# so put the allocation in your own ~/.sge_request once:
#
#     echo "-P <your_project>" >> ~/.sge_request
#
# and submit with a plain `qsub scripts/chemspace.qsub`. A one-off project
# overrides it on the command line: `qsub -P <other> scripts/chemspace.qsub`.

set -euo pipefail

# Keep caches off $HOME: it is over quota on the SCC, and matplotlib only warns
# about a failed font cache write before falling back to a slow rebuild.
export MPLCONFIGDIR="${TMPDIR:-/tmp}/mpl-cache"
mkdir -p "$MPLCONFIGDIR"

# numba (UMAP's backend) also caches, and defaults into $HOME.
export NUMBA_CACHE_DIR="${TMPDIR:-/tmp}/numba-cache"
mkdir -p "$NUMBA_CACHE_DIR"

module load miniconda

# Activation must be fatal. Without `set -e` plus this check a missing env
# leaves the job running in base conda, where the packaged polars is built for
# CPU features these nodes lack and every script dies with SIGILL -- a
# confusing crash several steps removed from the actual cause.
CONDA_ENV="${CONDA_ENV:-cyp}"
if ! conda activate "$CONDA_ENV" 2>/dev/null; then
    echo "Could not activate conda env '$CONDA_ENV'." >&2
    echo "Set CONDA_ENV to the env head_search.qsub uses. Available:" >&2
    conda info --envs >&2
    exit 1
fi

cd "$SGE_O_WORKDIR"

# The union must be the one head-search ran on -- the one carrying the ChEMBL
# and BindingDB family columns, not a qHTS-only build. The script warns and
# draws a half-empty map rather than failing if it is not, so check the log.
UNION="${UNION:-data/union_train.csv}"
if ! head -1 "$UNION" | grep -q "bindingdb\|chembl"; then
    echo "WARNING: $UNION has no family (chembl/bindingdb) columns." >&2
    echo "The family datasets are what the gain question is about. Rebuild with:" >&2
    echo "  build-family-datasets && build-family-heads && build-union \\" >&2
    echo "    --auxiliary pubchem=data/pubchem_aid1851.csv family=data/family_heads.csv && add-split-column" >&2
fi

python scripts/chemspace.py \
    --data-path "$UNION" \
    --test-path data/test.csv \
    --results-path results/head_search.json \
    --out-dir reports \
    --embedding-out results/chemspace_embedding.csv \
    --methods pca tsne umap \
    --gain-metric per-head
