#!/bin/bash -l
#$ -P your_project_here      # TODO: SCC project allocation (buy-in or class project)
#$ -N head_search
#$ -j y
#$ -o head_search.qlog
#$ -l h_rt=48:00:00          # greedy over k candidates ~ 1+k(k+1)/2 configs x seeds x epochs; pad generously
#$ -l gpus=1
#$ -l gpu_c=7.0               # min compute capability -- KEEP this; older GPUs lack kernels for
                               # our torch build (cudaErrorNoKernelImageForDevice). Raise it (e.g.
                               # 8.0) if the same error recurs, don't drop it.
#$ -pe omp 4                 # CPU cores for featurization/dataloading alongside the GPU

module load miniconda
conda activate openadmet-cyp   # TODO: adjust to whatever env/venv this repo was installed into

cd "$SGE_O_WORKDIR"
bash scripts/run_head_search.sh
