#!/bin/bash -l
#$ -P buaisociety
#$ -N train_unimol
#$ -j y
#$ -o train_unimol.qlog
#$ -l h_rt=24:00:00          # 3 learning rates x 3 seeds = 9 sequential multi-task fine-tunes; pad generously
#$ -l gpus=1
#$ -l gpu_c=9.0               # min compute capability -- KEEP this; older GPUs lack kernels for
                               # our torch build (cudaErrorNoKernelImageForDevice). Raise it (e.g.
                               # 8.0) if the same error recurs, don't drop it.
#$ -pe omp 4                 # CPU cores for conformer generation/dataloading alongside the GPU

module load miniconda
conda activate cyp

export PYTHONNOUSERSITE=1      # don't let ~/.local packages shadow the conda env
cd "$SGE_O_WORKDIR"
export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"

set -euo pipefail

# Data is gitignored; fetch it once on the cluster (skips files already present):
#   download-data
if [ ! -f data/train.csv ] || [ ! -d data/metabolism ]; then
    echo "Missing data/. Run download-data first." >&2
    exit 1
fi

# Extra args choose the auxiliary datasets (the challenge is always included), e.g.
#   qsub scripts/train_unimol.qsub --datasets pubchem:CYP1A2 bindingdb:CYP1A2,CYP2C8
# With none, trains on the challenge only. See: train-model --list-datasets
LEARNING_RATES=(5e-5 2e-4 5e-4)
SEEDS=(0 1 2)

for lr in "${LEARNING_RATES[@]}"; do
    for seed in "${SEEDS[@]}"; do
        echo "=== lr=$lr seed=$seed ==="
        python -m models.train_model --model unimol \
            --learning-rate "$lr" \
            --seed "$seed" \
            "$@"
    done
done
