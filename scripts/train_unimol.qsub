#!/bin/bash -l
#$ -P buaisociety
#$ -N train_unimol
#$ -j y
#$ -o train_unimol.qlog
#$ -l h_rt=24:00:00          # 3 learning rates x 3 seeds x number of configs sequential fine-tunes; raise for several configs
#$ -l gpus=1
#$ -l gpu_c=9.0               # min compute capability -- KEEP this; older GPUs lack kernels for
                               # our torch build (cudaErrorNoKernelImageForDevice). Raise it (e.g.
                               # 8.0) if the same error recurs, don't drop it.
#$ -pe omp 4                 # CPU cores for conformer generation/dataloading alongside the GPU

module load miniconda
conda activate cyp

export PYTHONNOUSERSITE=1      # don't let ~/.local packages shadow the conda env
cd "$SGE_O_WORKDIR"
export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"

set -euo pipefail

# Data is gitignored; fetch it once on the cluster (skips files already present):
#   download-data
if [ ! -f data/train.csv ] || [ ! -d data/metabolism ]; then
    echo "Missing data/. Run download-data first." >&2
    exit 1
fi

# Every --datasets config is trained once per seed (configs x seeds models) per learning rate (override with --learning-rate ...). Pass the
# configs as job args; 'challenge' alone is the challenge only, 'no_challenge' trains on the auxiliary data only:
#   qsub scripts/train_unimol.qsub --datasets challenge --datasets pubchem:CYP1A2 bindingdb:CYP2C8 \
#        --datasets no_challenge pubchem:CYP1A2 bindingdb:CYP2C8
# See: train-model --list-datasets
if [ "$#" -eq 0 ]; then
    set -- --datasets challenge
fi
python -m models.train_model --model unimol \
    --learning-rate 5e-5 2e-4 5e-4 \
    --n-seeds 3 --seed 0 \
    "$@"
